# ─── App ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production
DEBUG=false
STT_LLM_TTS_ENABLED=false
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TELEPHONY_COST_PER_MINUTE_INR=
DEEPGRAM_COST_PER_MINUTE_INR=
LLM_INPUT_COST_PER_MILLION_TOKENS_INR=
LLM_OUTPUT_COST_PER_MILLION_TOKENS_INR=
ELEVENLABS_COST_PER_MILLION_CHARACTERS_INR=

# ─── Database ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# ─── CORS ──────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
# Optional: comma-separated list of additional allowed origins
ALLOWED_ORIGINS=

# ─── URLs (update with your ngrok URL or domain) ───────
BACKEND_PUBLIC_URL=https://your-ngrok-or-domain.com
BACKEND_URL=https://your-ngrok-or-domain.com

# ─── Twilio ────────────────────────────────────────────
TWILIO_MEDIA_STREAM_WS_URL=wss://your-ngrok-or-domain.com/api/telephony/twilio/media-stream

# ─── Gemini ────────────────────────────────────────────
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# ─── Twilio-Gemini Bridge ──────────────────────────────
TWILIO_GEMINI_LOG_LEVEL=info                  # debug | info | warn | error
TWILIO_GEMINI_PROGRESS_LOGS=false
TWILIO_GEMINI_PROGRESS_LOG_INTERVAL=250       # ms between progress logs
TWILIO_GEMINI_MAX_CALL_WRAPUP_GRACE_SECONDS=30
TWILIO_GEMINI_PROACTIVE_GREETING_ENABLED=true
TWILIO_GEMINI_PROACTIVE_GREETING_RETRY_MS=2200
TWILIO_GEMINI_PROACTIVE_GREETING_MAX_RETRIES=1
TWILIO_GEMINI_PREWARM_ENABLED=true
TWILIO_GEMINI_PREWARM_TTL_MS=120000
TWILIO_GEMINI_PREWARM_MAX_BUFFER_MS=5000
TWILIO_GEMINI_REPORTS_ENABLED=false
TWILIO_GEMINI_REPORT_PATH=reports/twilio-gemini-sessions.ndjson

# ─── Gemini Token Pricing (USD per 1M tokens) ──────────
TWILIO_GEMINI_INPUT_TEXT_USD_PER_1M=
TWILIO_GEMINI_INPUT_AUDIO_USD_PER_1M=
TWILIO_GEMINI_INPUT_IMAGE_VIDEO_USD_PER_1M=
TWILIO_GEMINI_OUTPUT_TEXT_USD_PER_1M=
TWILIO_GEMINI_OUTPUT_AUDIO_USD_PER_1M=
